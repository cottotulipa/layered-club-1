# ============================================================
# 취준 대시보드 환경 변수 설정
# 이 파일을 복사해서 .env.local로 사용하세요.
# ============================================================

# ── Clerk (인증) ─────────────────────────────────────────────
# https://dashboard.clerk.com 에서 발급
# 1. 프로젝트 생성 → "Google" 소셜 로그인 활성화
# 2. API Keys 탭에서 복사
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk 라우팅 설정 (변경 불필요)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ── Supabase (데이터베이스) ───────────────────────────────────
# https://supabase.com/dashboard 에서 발급
# 1. 새 프로젝트 생성
# 2. Settings > API 탭에서 복사
# 3. supabase/schema.sql을 SQL Editor에서 실행
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # service_role 키 (anon 키 아님!)

# ── Anthropic (AI 인사이트, 선택사항) ────────────────────────
# https://console.anthropic.com 에서 발급
# 없으면 기본 분석으로 대체됩니다.
ANTHROPIC_API_KEY=sk-ant-...
